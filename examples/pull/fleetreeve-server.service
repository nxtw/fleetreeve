# /etc/systemd/system/fleetreeve-server.service - the pull-mode server.
#
# Expects a checkout of your manifests in /srv/fleetreeve (update it with
# `git pull`; no restart needed) and a dedicated user:
#   useradd --system --home /var/lib/fleetreeve-server --create-home fleetreeve
# The TLS certificate must be readable by that user.
[Unit]
Description=fleetreeve pull-mode server
After=network-online.target
Wants=network-online.target

[Service]
User=fleetreeve
WorkingDirectory=/srv/fleetreeve
ExecStart=/usr/local/bin/fleetreeve serve \
    -i inventory.yaml \
    -secret-file /var/lib/fleetreeve-server/secret \
    -tls-cert /etc/fleetreeve/tls/server.crt \
    -tls-key /etc/fleetreeve/tls/server.key \
    -reports /var/lib/fleetreeve-server/reports \
    -hosts /var/lib/fleetreeve-server/hosts \
    -actions /var/lib/fleetreeve-server/actions \
    -listen :8140 \
    site.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fleetreeve-server

[Install]
WantedBy=multi-user.target
